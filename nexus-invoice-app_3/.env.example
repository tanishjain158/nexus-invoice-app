# Copy to .env and set real values before deploying anywhere reachable off your own machine.
# Leaving these unset disables the login entirely (see README → "Logging in").
APP_USERNAME=change-me
APP_PASSWORD=change-me-to-a-long-random-password

PORT=4000

# Optional: where the SQLite database lives (defaults to ./data).
# DATA_DIR=/app/data

# Optional: path to a Chrome/Chromium binary for PDF generation.
# CHROME_PATH=/usr/bin/chromium
